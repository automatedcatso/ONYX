# Canonical application origin. Use HTTPS in production and no trailing path.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3010

# Supabase public browser configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only elevated key. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only SMTP configuration for confirmation and recovery links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional server-only Gemini configuration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODERATION_MODEL=gemini-3.5-flash-lite

# Server-only Vercel cron secret. Use at least 32 random characters.
CRON_SECRET=
