# Public application URL. The isolated local launcher uses this loopback origin.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3010

# Supabase project. All three values are required for production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only SMTP. Production email attempts fail closed when these are missing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional server-only Gemini configuration. Without it, the assistant searches the real catalog.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional separate multimodal model for listing image pre-moderation.
GEMINI_MODERATION_MODEL=gemini-3.5-flash-lite

# Required for the Vercel maintenance schedule. Generate a long random value.
CRON_SECRET=
