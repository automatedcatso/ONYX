{
  "name": "onyx-campus-marketplace",
  "version": "1.2.2",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 3010",
    "dev:lan": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev --hostname 0.0.0.0 --port 3010",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "eslint . --ignore-pattern .next",
    "typecheck": "cross-env NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test": "npm run test:security && npm run test:repo && npm run test:sql",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:security": "node --test tests/security.test.mjs",
    "test:repo": "node scripts/verify-repository.mjs",
    "test:sql": "node scripts/check-sql.mjs",
    "verify:env": "node --env-file-if-exists=.env.local scripts/verify-env.mjs",
    "check:source": "npm test"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@supabase/supabase-js": "^2.112.2",
    "next": "16.3.0",
    "nodemailer": "^9.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "cross-env": "10.1.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "ws": "8.21.1"
  },
  "type": "module",
  "displayName": "ONYX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/automatedcatso/ONYX.git"
  },
  "bugs": {
    "url": "https://github.com/automatedcatso/ONYX/issues"
  },
  "homepage": "https://github.com/automatedcatso/ONYX#readme"
}
