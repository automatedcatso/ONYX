{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "functions": {
    "app/api/assistant/route.ts": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/cron/maintenance", "schedule": "17 3 * * *" }
  ]
}
